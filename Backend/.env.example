# ==============================================================================
# SPORTHUB AI - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# File mẫu cấu hình môi trường - An toàn để commit lên Git/GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & DỰ ÁN
# ------------------------------------------------------------------------------
PROJECT_NAME="SportHub AI"
TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & MÃ HÓA (SECURITY & TOKENS)
# ------------------------------------------------------------------------------
# Tạo khóa ngẫu nhiên (tối thiểu 32 ký tự): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_secret_key_here_at_least_32_characters
API_KEY_ENCRYPTION_KEY=your_encryption_key_here_for_sensitive_data
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU (DATABASE)
# ------------------------------------------------------------------------------
# SQLite (mặc định): sqlite:///./data/sporthub.db
# PostgreSQL: postgresql://username:password@localhost:5432/sporthub_db
DATABASE_URL=sqlite:///./data/sporthub.db

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN MẪU & KHỞI TẠO DỮ LIỆU (SEED ACCOUNTS)
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=false
SYNC_DEMO_PASSWORDS=false

SYSTEM_ADMIN_FULL_NAME="SportHub System Admin"
SYSTEM_ADMIN_EMAIL=admin@yourdomain.com
SYSTEM_ADMIN_PASSWORD=your_system_admin_password_here

OWNER_FULL_NAME="SportHub Owner"
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=your_owner_password_here

CUSTOMER_EMAIL=customer@yourdomain.com
CUSTOMER_PASSWORD=your_customer_password_here

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH TRỢ LÝ TRÍ TUỆ NHÂN TẠO (AI ASSISTANT & LLM)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_PROVIDER_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH THANH TOÁN & NGÂN HÀNG (VIETQR / BANKING GATEWAY)
# ------------------------------------------------------------------------------
# PAYMENT_MODE: 'demo' (tự động duyệt) hoặc 'production'
PAYMENT_MODE=demo
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
BANK_ID=MB
BANK_NAME="MB Bank"
BANK_ACCOUNT_NO=your_bank_account_number_here
BANK_ACCOUNT_NAME="YOUR COMPANY OR ACCOUNT NAME"

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH GỬI EMAIL THÔNG BÁO & OTP (SMTP)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="SportHub AI"
SMTP_CRYPTO=tls
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH GỬI TIN NHẮN SMS OTP
# ------------------------------------------------------------------------------
# SMS_PROVIDER: 'demo' (ghi log mã OTP vào console để test) hoặc 'twilio'
SMS_ENABLED=false
SMS_PROVIDER=demo
SMS_ACCOUNT_SID=your_twilio_account_sid_here
SMS_API_KEY=your_sms_api_key_here
SMS_SECRET_KEY=your_sms_secret_key_here
SMS_FROM_NUMBER=+84900000000
SMS_BRAND_NAME="SportHub"

# ------------------------------------------------------------------------------
# 9. CẤU HÌNH QUÊN MẬT KHẨU & MÃ XÁC THỰC OTP
# ------------------------------------------------------------------------------
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# ------------------------------------------------------------------------------
# 10. LƯU TRỮ TỆP TIN & GIỚI HẠN DUNG LƯỢNG TẢI LÊN (FILE STORAGE)
# ------------------------------------------------------------------------------
AVATAR_DIR=./data/public/avatars
AVATAR_MAX_BYTES=5242880

FACILITY_IMAGE_DIR=./data/public/facility_images
FACILITY_IMAGE_MAX_BYTES=5242880

FACILITY_PRIVATE_DIR=./data/private/facility_documents
FACILITY_DOCUMENT_MAX_BYTES=10485760


