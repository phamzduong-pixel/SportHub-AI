# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
API_KEY_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
# Tạo API key thật tại nhà cung cấp rồi chỉ dán vào .env, không commit lên Git.
OPENAI_API_KEY=replace-with-your-openai-api-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/sporthub.db
TIMEZONE=Asia/Ho_Chi_Minh
PARTNER_DOCUMENT_DIR=./data/private/partner_documents
PARTNER_DOCUMENT_MAX_BYTES=5242880
AVATAR_DIR=./data/public/avatars
AVATAR_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo chỉ chạy khi bật true. Hãy thay mật khẩu trước khi dùng ngoài máy cá nhân.
SEED_DEMO_DATA=true
OWNER_EMAIL=owner@sporthub.local
OWNER_PASSWORD=replace-with-demo-owner-password
OWNER_FULL_NAME=SportHub Owner
CUSTOMER_EMAIL=customer@sporthub.local
CUSTOMER_PASSWORD=replace-with-demo-customer-password
SYSTEM_ADMIN_EMAIL=admin@sporthub.local
SYSTEM_ADMIN_PASSWORD=replace-with-strong-system-admin-password
SYSTEM_ADMIN_FULL_NAME=SportHub System Admin
