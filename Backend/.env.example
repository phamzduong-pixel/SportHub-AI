# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
API_KEY_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
# Tạo API key thật tại nhà cung cấp rồi chỉ dán vào .env, không commit lên Git.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6
AI_PROVIDER_TIMEOUT_SECONDS=8
AI_PROVIDER_MAX_RETRIES=1
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/sporthub.db
TIMEZONE=Asia/Ho_Chi_Minh
AVATAR_DIR=./data/public/avatars
AVATAR_MAX_BYTES=5242880
FACILITY_IMAGE_DIR=./data/public/facility_images
FACILITY_PRIVATE_DIR=./data/private/facility_documents
FACILITY_IMAGE_MAX_BYTES=5242880
FACILITY_DOCUMENT_MAX_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo chỉ chạy khi bật true. Hãy thay mật khẩu trước khi dùng ngoài máy cá nhân.
SEED_DEMO_DATA=true
# Chỉ bật tạm thời khi cần đồng bộ lại password của tài khoản demo đã tồn tại.
SYNC_DEMO_PASSWORDS=false
OWNER_EMAIL=owner@sporthub.local
OWNER_PASSWORD=replace-with-demo-owner-password
OWNER_FULL_NAME=SportHub Owner
CUSTOMER_EMAIL=customer@sporthub.local
CUSTOMER_PASSWORD=replace-with-demo-customer-password
SYSTEM_ADMIN_EMAIL=admin@sporthub.local
SYSTEM_ADMIN_PASSWORD=replace-with-strong-system-admin-password
SYSTEM_ADMIN_FULL_NAME=SportHub System Admin

# ==========================================
# Cấu hình Gửi Email (SMTP)
# ==========================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_PASS=your-app-password
SMTP_CRYPTO=tls
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SportHub AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ==========================================
# Cấu hình Gửi Tin nhắn SMS
# ==========================================
SMS_ENABLED=true
# SMS_PROVIDER: 'demo' (mock log for dev), 'twilio', 'esms'
SMS_PROVIDER=demo
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_API_KEY=your-api-key
SMS_SECRET_KEY=your-secret-key
SMS_FROM_NUMBER=+1234567890
SMS_BRAND_NAME=SportHub

# ==========================================
# Cấu hình Xác thực Quên mật khẩu & OTP
# ==========================================
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
